# ============================================================
# Nodum — STAGING environment
# ============================================================
#   cp .env.staging.example .env.staging   # then fill every value below
#   chmod 600 .env.staging
#
# Staging runs the SAME compose layer as production
# (docker-compose.deploy.yml): same edge proxy, same network split, same
# one-shot migration, same noeviction control-plane Redis. A staging
# environment that differs structurally from production tells you nothing
# about production.
#
# ENVIRONMENT=staging maps to ProductionSettings in the API, so the
# placeholder-secret guard applies here too. Staging gets its own real
# credentials — never production's, and never the dev defaults.
#
# Generate secrets exactly as for production:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ============================================================

# ── Site ────────────────────────────────────────────────────
# A hostname gets automatic HTTPS. Use ":80" for an internal staging box that
# already sits behind a load balancer or a VPN.
NODUM_SITE_ADDRESS=staging.nodum.example.com

# Defaults to 8080/8443 so staging and production can share one host.
NODUM_HTTP_PORT=8080
NODUM_HTTPS_PORT=8443

# ── URLs ────────────────────────────────────────────────────
# Include the port if you are reaching staging on 8080/8443 directly rather
# than through a load balancer on the standard ports.
FRONTEND_BASE_URL=https://staging.nodum.example.com
BACKEND_CORS_ORIGINS=https://staging.nodum.example.com

# ── Secrets (distinct from production) ──────────────────────
SECRET_KEY=
JWT_SECRET_KEY=

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=nodum
POSTGRES_PASSWORD=
POSTGRES_DB=nodum

# ── Object storage (attachments) ────────────────────────────
# Pick ONE of the two blocks below.
#
# Attachments are handed to the browser as presigned URLs either way. What
# differs is who serves the bytes — and getting S3_PUBLIC_URL wrong shows up as
# broken images, never as an error at boot.

# ── Option A: bundled MinIO (default, self-contained) ───────
# Runs in the stack; Caddy proxies it at /s3. S3_PUBLIC_URL is therefore your
# own origin with /s3 on the end, NOT a MinIO host and port. You own the
# backups for it (docs/backup.md).
S3_PUBLIC_URL=https://staging.nodum.example.com/s3
MINIO_ROOT_USER=nodum
MINIO_ROOT_PASSWORD=

# ── Option B: a managed store ───────────────────────────────
# Set S3_ENDPOINT_URL and compose.sh drops MinIO, its volume and its memory
# budget from the stack — on a small host, the biggest simplification available,
# and the provider handles durability. Works with Hetzner Object Storage, AWS
# S3, Cloudflare R2, Backblaze B2, or any S3-compatible endpoint.
#
# S3_PUBLIC_URL must EQUAL S3_ENDPOINT_URL here: the presigned URL is already
# public, so nothing rewrites it. Delete the Option A lines above if you use
# this, and note the /s3 Caddy route simply goes unused.
#
# S3_REGION is not cosmetic — SigV4 signs it, so a wrong value fails every
# request with SignatureDoesNotMatch. Hetzner uses the location code (fsn1,
# nbg1, hel1); AWS uses eu-central-1 etc.; R2 uses auto.
#
# No bucket CORS is needed: attachments only ever land in an <img>/<iframe>
# src attribute, never in a fetch().
#
# S3_ENDPOINT_URL=https://fsn1.your-objectstorage.com
# S3_PUBLIC_URL=https://fsn1.your-objectstorage.com
# S3_BUCKET_NAME=nodum
# S3_REGION=fsn1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ── AI (bring your own key) ─────────────────────────────────
AI_ENCRYPTION_KEY=
# Staging is a good place to exercise a self-hosted inference endpoint on the
# internal network. Only do that if staging is not open to the public — the
# value is user-supplied and the server is what fetches it.
AI_ALLOW_PRIVATE_BASE_URLS=false

# ── Google OAuth (optional) ─────────────────────────────────
# Needs its own client, with staging's callback registered:
#   https://staging.nodum.example.com/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email verification ──────────────────────────────────────
# Staging mirrors production, so this is on and needs a provider. Point it at
# a mailbox you own — staging signups send real email.
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_FROM_ADDRESS=no-reply@staging.nodum.example.com
EMAIL_FROM_NAME=Nodum (staging)
# Ordered failover chain; see .env.prod.example for the free-tier notes.
EMAIL_PROVIDERS=brevo,mailjet,resend,mailgun,smtp
BREVO_API_KEY=
MAILJET_API_KEY=
MAILJET_API_SECRET=
RESEND_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=us
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_USE_SSL=false

# ── Reverse proxy ───────────────────────────────────────────
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_HOPS=1

# ── Monitoring (optional) ───────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Higher than production on purpose: staging traffic is cheap to sample and
# tracing is most useful while you are still finding the slow paths.
SENTRY_TRACES_SAMPLE_RATE=0.2
LOG_LEVEL=DEBUG

# ── Capacity ────────────────────────────────────────────────
# Smaller than production so staging can share a box. The topology is
# identical; only the sizing differs.
API_WORKERS=2
CELERY_CONCURRENCY=2
CELERY_LOG_LEVEL=INFO

API_CPU_LIMIT=1
API_MEM_LIMIT=768m
WORKER_CPU_LIMIT=1
WORKER_MEM_LIMIT=768m
BEAT_CPU_LIMIT=0.25
BEAT_MEM_LIMIT=256m
WEB_CPU_LIMIT=1
WEB_MEM_LIMIT=512m
CADDY_CPU_LIMIT=0.5
CADDY_MEM_LIMIT=128m

POSTGRES_MEM_LIMIT=1g
MINIO_MEM_LIMIT=512m
REDIS_MAXMEMORY=256mb
REDIS_MEM_LIMIT=384m
REDIS_CONTROL_MAXMEMORY=64mb
REDIS_CONTROL_MEM_LIMIT=128m
