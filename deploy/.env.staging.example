# ============================================================
# Nodum — STAGING environment
# ============================================================
#   cp .env.staging.example .env.staging   # then fill every value below
#   chmod 600 .env.staging
#
# Staging runs the SAME compose layer as production
# (docker-compose.deploy.yml): same edge proxy, same network split, same
# one-shot migration, same noeviction control-plane Redis. A staging
# environment that differs structurally from production tells you nothing
# about production.
#
# ENVIRONMENT=staging maps to ProductionSettings in the API, so the
# placeholder-secret guard applies here too. Staging gets its own real
# credentials — never production's, and never the dev defaults.
#
# Generate secrets exactly as for production:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ============================================================

# ── Site ────────────────────────────────────────────────────
# A hostname gets automatic HTTPS. Use ":80" for an internal staging box that
# already sits behind a load balancer or a VPN.
NODUM_SITE_ADDRESS=staging.nodum.example.com

# Defaults to 8080/8443 so staging and production can share one host.
NODUM_HTTP_PORT=8080
NODUM_HTTPS_PORT=8443

# ── URLs ────────────────────────────────────────────────────
# Include the port if you are reaching staging on 8080/8443 directly rather
# than through a load balancer on the standard ports.
FRONTEND_BASE_URL=https://staging.nodum.example.com
BACKEND_CORS_ORIGINS=https://staging.nodum.example.com
# Your own origin with /s3 — Caddy proxies presigned attachment URLs there.
S3_PUBLIC_URL=https://staging.nodum.example.com/s3

# ── Secrets (distinct from production) ──────────────────────
SECRET_KEY=
JWT_SECRET_KEY=

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=nodum
POSTGRES_PASSWORD=
POSTGRES_DB=nodum

# ── MinIO (attachment storage) ──────────────────────────────
MINIO_ROOT_USER=nodum
MINIO_ROOT_PASSWORD=

# ── AI (bring your own key) ─────────────────────────────────
AI_ENCRYPTION_KEY=
# Staging is a good place to exercise a self-hosted inference endpoint on the
# internal network. Only do that if staging is not open to the public — the
# value is user-supplied and the server is what fetches it.
AI_ALLOW_PRIVATE_BASE_URLS=false

# ── Google OAuth (optional) ─────────────────────────────────
# Needs its own client, with staging's callback registered:
#   https://staging.nodum.example.com/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Reverse proxy ───────────────────────────────────────────
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_HOPS=1

# ── Monitoring (optional) ───────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Higher than production on purpose: staging traffic is cheap to sample and
# tracing is most useful while you are still finding the slow paths.
SENTRY_TRACES_SAMPLE_RATE=0.2
LOG_LEVEL=DEBUG

# ── Capacity ────────────────────────────────────────────────
# Smaller than production so staging can share a box. The topology is
# identical; only the sizing differs.
API_WORKERS=2
CELERY_CONCURRENCY=2
CELERY_LOG_LEVEL=INFO

API_CPU_LIMIT=1
API_MEM_LIMIT=768m
WORKER_CPU_LIMIT=1
WORKER_MEM_LIMIT=768m
BEAT_CPU_LIMIT=0.25
BEAT_MEM_LIMIT=256m
WEB_CPU_LIMIT=1
WEB_MEM_LIMIT=512m
CADDY_CPU_LIMIT=0.5
CADDY_MEM_LIMIT=128m

POSTGRES_MEM_LIMIT=1g
MINIO_MEM_LIMIT=512m
REDIS_MAXMEMORY=256mb
REDIS_MEM_LIMIT=384m
REDIS_CONTROL_MAXMEMORY=64mb
REDIS_CONTROL_MEM_LIMIT=128m
