# ============================================================
# Nodum — PRODUCTION environment
# ============================================================
#   cp .env.prod.example .env.prod    # then fill every value below
#   chmod 600 .env.prod               # it holds every credential you have
#
# .env.prod is gitignored. compose.sh will NOT fall back to .env for
# production: sharing one file is how a deploy ends up on the dev database
# with credentials that are published in this repository.
#
# The API refuses to boot on placeholder or known-default values — see
# back/app/settings/production.py. That check is the last line of defence,
# not a substitute for reading this file.
#
# Generate secrets:
#   SECRET_KEY / JWT_SECRET_KEY  python3 -c "import secrets; print(secrets.token_hex(32))"
#   passwords                    python3 -c "import secrets; print(secrets.token_urlsafe(24))"
#   AI_ENCRYPTION_KEY            python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# ENVIRONMENT is not set here. compose.sh exports it, so the stack you get is
# decided by the command you typed rather than by a file you may have copied.
# ============================================================

# ── Site ────────────────────────────────────────────────────
# The public hostname Caddy serves. Set it to a bare domain and Caddy obtains
# and renews a TLS certificate on its own (ports 80 and 443 must reach this
# host, and DNS must already point here).
#   nodum.example.com   -> automatic HTTPS
#   :80                 -> plain HTTP, no ACME (only behind another TLS terminator)
NODUM_SITE_ADDRESS=nodum.example.com

# Host ports the edge proxy publishes. Only change these if something else
# already owns 80/443, or to run this stack locally for verification.
NODUM_HTTP_PORT=80
NODUM_HTTPS_PORT=443

# ── URLs ────────────────────────────────────────────────────
# The public origin of the site. Used for CORS and — importantly — as the
# OAuth redirect base: it is where the browser lands after Google sign-in, and
# the callback reaches the API through the proxy at /api. Must match
# NODUM_SITE_ADDRESS and the redirect URI registered in Google Cloud Console.
FRONTEND_BASE_URL=https://nodum.example.com
BACKEND_CORS_ORIGINS=https://nodum.example.com

# Where the browser fetches attachments. Attachments are served straight from
# MinIO over presigned URLs, and Caddy proxies them at /s3 — so this is your
# own origin with /s3 on the end, NOT a MinIO host/port.
# Getting this wrong shows up as broken images, not as an error at boot.
S3_PUBLIC_URL=https://nodum.example.com/s3

# ── Secrets ─────────────────────────────────────────────────
SECRET_KEY=
JWT_SECRET_KEY=

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=nodum
POSTGRES_PASSWORD=
POSTGRES_DB=nodum

# ── MinIO (attachment storage) ──────────────────────────────
MINIO_ROOT_USER=nodum
MINIO_ROOT_PASSWORD=

# ── AI (bring your own key) ─────────────────────────────────
# Empty turns the AI feature off entirely. Rotating this makes every stored
# provider key unreadable and users must re-enter theirs, so it is not
# rotatable the way SECRET_KEY is.
AI_ENCRYPTION_KEY=
# Keep false on a multi-tenant install. The provider base_url is supplied by
# users and fetched by the server, so allowing private targets lets any signed
# up account probe your internal network and the cloud metadata endpoint.
AI_ALLOW_PRIVATE_BASE_URLS=false

# ── Google OAuth (optional) ─────────────────────────────────
# Authorised redirect URI in Google Cloud Console:
#   https://nodum.example.com/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Reverse proxy ───────────────────────────────────────────
# Caddy runs inside this stack and is the single trusted hop, so leave these.
# The client address is read this many hops from the RIGHT of X-Forwarded-For,
# which is what stops a forged header from minting its own rate-limit bucket.
# Add a hop for each additional proxy or CDN you put in front of Caddy.
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_HOPS=1

# ── Monitoring (optional) ───────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Errors only by default; every sampled transaction is billed.
SENTRY_TRACES_SAMPLE_RATE=0.0
LOG_LEVEL=INFO

# ── Capacity ────────────────────────────────────────────────
# Defaults suit a 4-core / 8GB host. Raise API_WORKERS and CELERY_CONCURRENCY
# with cores; keep the memory limits comfortably under total RAM, since these
# are hard caps and the kernel OOM-kills rather than swaps.
API_WORKERS=4
CELERY_CONCURRENCY=4
CELERY_LOG_LEVEL=INFO

API_CPU_LIMIT=2
API_MEM_LIMIT=1g
WORKER_CPU_LIMIT=2
WORKER_MEM_LIMIT=1g
BEAT_CPU_LIMIT=0.5
BEAT_MEM_LIMIT=384m
WEB_CPU_LIMIT=1
WEB_MEM_LIMIT=512m
CADDY_CPU_LIMIT=1
CADDY_MEM_LIMIT=256m

POSTGRES_MEM_LIMIT=2g
MINIO_MEM_LIMIT=1g
# Cache Redis: evictable by design (allkeys-lru).
REDIS_MAXMEMORY=512mb
REDIS_MEM_LIMIT=768m
# Control-plane Redis: noeviction. Holds rate-limit counters, token revocation
# and refresh-grace keys — state that must not disappear under memory pressure.
REDIS_CONTROL_MAXMEMORY=128mb
REDIS_CONTROL_MEM_LIMIT=256m

# Note: BACKEND_BASE_URL appeared in older examples. It is a declared setting
# that nothing in the application reads, so it is no longer required or passed.
