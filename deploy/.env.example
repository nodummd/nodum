# ============================================================
# Nodum — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control (it is gitignored).
#
# Key generation commands:
#   SECRET_KEY:      python3 -c "import secrets; print(secrets.token_hex(32))"
#   JWT_SECRET_KEY:  python3 -c "import secrets; print(secrets.token_hex(32))"
#   Passwords:       python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# ============================================================

# ── Core application ────────────────────────────────────────
ENVIRONMENT=dev                     # dev | test | staging | production
SECRET_KEY=change-me-generate-a-random-64-char-string
JWT_SECRET_KEY=change-me-generate-a-random-64-char-string
LOG_LEVEL=DEBUG

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=nodum
POSTGRES_PASSWORD=nodum             # CHANGE for production
POSTGRES_DB=nodum

# ── MinIO (S3-compatible attachment storage) ────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin      # CHANGE for production
S3_PUBLIC_URL=http://localhost:9000

# ── URLs (production) ───────────────────────────────────────
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── Monitoring (optional) ───────────────────────────────────
SENTRY_DSN=
