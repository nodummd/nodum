# ============================================================
# Nodum — DEVELOPMENT environment
# ============================================================
#   cp .env.example .env      # the values below already work as-is
#   ./compose.sh dev up -d
#
# This file is for the dev and test stacks only. Staging and production have
# their own examples (.env.staging.example, .env.prod.example) and compose.sh
# will not let them fall back to this one — these credentials are published in
# a public repository, so they must never reach a deployed host.
#
# Every value here is a working default. Nothing needs editing to get started;
# the only optional step is AI_ENCRYPTION_KEY if you want to try the AI panel.
# ============================================================

# ── Secrets (dev only — see .env.prod.example for real ones) ─
# Long enough to keep HS256 happy, and they carry "change-me" so
# ProductionSettings refuses to boot if they ever leak into a deployment.
SECRET_KEY=change-me-dev-only-not-a-real-secret-key-000
JWT_SECRET_KEY=change-me-dev-only-not-a-real-jwt-secret-000

# ── PostgreSQL ──────────────────────────────────────────────
# Reachable from the host at 127.0.0.1:15432 (dev) / 55432 (test).
POSTGRES_USER=nodum
POSTGRES_PASSWORD=nodum
POSTGRES_DB=nodum

# ── MinIO (attachment storage) ──────────────────────────────
# API on 127.0.0.1:19000, console on 127.0.0.1:19001.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── AI (bring your own key) ─────────────────────────────────
# Empty turns the AI feature off. To try it, generate one:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_ENCRYPTION_KEY=
# On in dev so you can point a provider at a self-hosted endpoint such as
# http://ollama:11434/v1. Production leaves this false — the value is
# user-supplied and the server is what fetches it.
AI_ALLOW_PRIVATE_BASE_URLS=true

# ── Live sync from Google (optional) ────────────────────────
# Keeps Calendar events — and, self-hosted, Gmail threads — arriving as notes
# and updating themselves. A SEPARATE OAuth client from sign-in above, and
# separate on purpose: one client shared between them would drag your login
# flow into Gmail's restricted-scope compliance regime the first time anyone
# connected a mailbox. Empty leaves the feature off and the UI says so.
#
# Authorised redirect URI in Google Cloud Console:
#   http://localhost:3000/api/v1/connections/google/callback
#
# PUBLISH THE CONSENT SCREEN. A project left on "Testing" gets refresh tokens
# that Google expires after exactly seven days, so sync works for a week and
# then dies with an opaque error. APIs & Services -> OAuth consent screen ->
# Publish app. Nodum detects this case and says so, but it cannot fix it.
GOOGLE_SYNC_CLIENT_ID=
GOOGLE_SYNC_CLIENT_SECRET=
# Gmail's API scopes are Google-*restricted*: a hosted, multi-user service that
# requests them owes a security audit by an accredited assessor, renewed
# annually at real cost. Leave this false unless you self-host for yourself,
# where Google's personal-use exemption applies. Calendar has no such
# restriction and works either way.
GOOGLE_SYNC_GMAIL_ENABLED=false
# Encrypts the stored Google refresh tokens. Falls back to AI_ENCRYPTION_KEY
# when empty; set it separately if you would rather the two not share a key.
# Rotating it makes every connection unreadable and users must reconnect.
OAUTH_ENCRYPTION_KEY=
