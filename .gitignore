# ── Secrets & environment ──────────────────────────────────
.env
.env.*
# Every *.example is a template with no real values — .env.example,
# .env.staging.example, .env.prod.example. The `.env.*` rule above would
# otherwise swallow the per-environment ones.
!.env*.example
*.pem
*.key
*.crt
secrets/
marketing/

# ── Python ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Node / Next.js ─────────────────────────────────────────
node_modules/
.next/
out/
dist/
*.tsbuildinfo
.eslintcache
.turbo/

# ── Playwright ─────────────────────────────────────────────
test-results/
playwright-report/
blob-report/

# ── OS / editor ────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ── Docker / local data ────────────────────────────────────
*.log
data/
pgdata/
minio-data/

